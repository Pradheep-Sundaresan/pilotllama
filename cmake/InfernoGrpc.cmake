# Opt-in bindings/adapter build. No downloads, global installs or model loads.
find_package(Git REQUIRED)
file(READ "${PROJECT_SOURCE_DIR}/third_party/grpc-revisions.json" grpc_pins)
string(JSON source_count LENGTH "${grpc_pins}" sources)
math(EXPR source_last "${source_count} - 1")
foreach(index RANGE ${source_last})
    string(JSON source_path GET "${grpc_pins}" sources ${index} path)
    string(JSON expected GET "${grpc_pins}" sources ${index} revision)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}/${source_path}" rev-parse HEAD
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Missing or unpinned ${source_path}; see docs/grpc-dependencies.md. Downloads require approval.")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}/${source_path}" status --porcelain
        OUTPUT_VARIABLE dirty RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT dirty STREQUAL "")
        message(FATAL_ERROR "Review local changes in ${source_path} before building")
    endif()
endforeach()

enable_language(C)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "" FORCE)
set(gRPC_INSTALL OFF CACHE BOOL "" FORCE)
set(gRPC_DOWNLOAD_ARCHIVES OFF CACHE BOOL "" FORCE)
set(gRPC_BUILD_GRPCPP_OTEL_PLUGIN OFF CACHE BOOL "" FORCE)
set(gRPC_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(gRPC_BUILD_CODEGEN ON CACHE BOOL "" FORCE)
set(gRPC_BUILD_GRPC_CPP_PLUGIN ON CACHE BOOL "" FORCE)
foreach(language CSHARP NODE OBJECTIVE_C PHP PYTHON RUBY)
    set(gRPC_BUILD_GRPC_${language}_PLUGIN OFF CACHE BOOL "" FORCE)
endforeach()
foreach(provider ABSL CARES PROTOBUF RE2 SSL ZLIB)
    set(gRPC_${provider}_PROVIDER module CACHE STRING "" FORCE)
endforeach()
set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_PROTOC_BINARIES ON CACHE BOOL "" FORCE)
set(protobuf_INSTALL OFF CACHE BOOL "" FORCE)
set(protobuf_WITH_ZLIB OFF CACHE BOOL "" FORCE)
set(protobuf_LOCAL_DEPENDENCIES_ONLY ON CACHE BOOL "" FORCE)
set(ABSL_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ABSL_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(RE2_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(CARES_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CARES_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(CARES_INSTALL OFF CACHE BOOL "" FORCE)
set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SKIP_INSTALL_ALL ON CACHE BOOL "" FORCE)
# Avoid zlib renaming a tracked header inside its source checkout.
set(RENAME_ZCONF OFF CACHE BOOL "" FORCE)
add_subdirectory("${PROJECT_SOURCE_DIR}/third_party/grpc" "${PROJECT_BINARY_DIR}/upstream-grpc" EXCLUDE_FROM_ALL)
# With source-header renaming disabled, retain zlib's checked POSIX feature flag.
if(Z_HAVE_UNISTD_H)
    target_compile_definitions(zlibstatic PUBLIC Z_HAVE_UNISTD_H=1)
endif()

set(proto_root "${PROJECT_SOURCE_DIR}/proto")
set(proto_input "${proto_root}/inferno/v1/inference.proto")
set(proto_output "${PROJECT_BINARY_DIR}/generated")
set(proto_base "${proto_output}/inferno/v1/inference")
add_custom_command(
    OUTPUT "${proto_base}.pb.cc" "${proto_base}.pb.h" "${proto_base}.grpc.pb.cc" "${proto_base}.grpc.pb.h"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${proto_output}"
    COMMAND $<TARGET_FILE:protoc> -I "${proto_root}" --cpp_out=${proto_output}
        --grpc_out=${proto_output} --plugin=protoc-gen-grpc=$<TARGET_FILE:grpc_cpp_plugin> "${proto_input}"
    DEPENDS "${proto_input}" protoc grpc_cpp_plugin
    VERBATIM)
add_library(inferno_proto STATIC "${proto_base}.pb.cc" "${proto_base}.grpc.pb.cc")
target_include_directories(inferno_proto PUBLIC "${proto_output}")
target_link_libraries(inferno_proto PUBLIC grpc++ protobuf::libprotobuf)
target_compile_features(inferno_proto PUBLIC cxx_std_20)
add_library(inferno_rpc STATIC "${PROJECT_SOURCE_DIR}/src/rpc/server.cpp")
target_link_libraries(inferno_rpc PUBLIC inferno_core inferno_proto)
target_compile_options(inferno_rpc PRIVATE -Wall -Wextra)
